[4.401859, "o", "\u001b[40m                                                                                                              \u001b[0m\r\n\u001b[40m \u001b[0m\u001b[91;40m--- a/models.py\u001b[0m\u001b[40m                                                                                             \u001b[0m\u001b[40m \u001b[0m\r\n\u001b[40m \u001b[0m\u001b[92;40m+++ b/models.py\u001b[0m\u001b[40m                                                                                             \u001b[0m\u001b[40m \u001b[0m\r\n\u001b[40m \u001b[0m\u001b[37;40m@@ -20,7 +20,7 @@\u001b[0m\u001b[40m                                                                                           \u001b[0m\u001b[40m \u001b[0m\r\n\u001b[40m \u001b[0m\u001b[97;40m \u001b[0m\u001b[97;40m@dataclass\u001b[0m\u001b[40m                                                                                                 \u001b[0m\u001b[40m \u001b[0m\r\n\u001b[40m \u001b[0m\u001b[97;40m \u001b[0m\u001b[97;40mclass Task:\u001b[0m\u001b[40m                                                                                                \u001b[0m\u001b[40m \u001b[0m\r\n\u001b[40m \u001b[0m\u001b[97;40m \u001b[0m\u001b[97;40m    id: int\u001b[0m\u001b[40m                                                                                                \u001b[0m\u001b[40m \u001b[0m\r\n\u001b[40m \u001b[0m\u001b[91;40m-    title: str\u001b[0m\u001b[40m                                                                                             \u001b[0m\u001b[40m \u001b[0m\r\n\u001b[40m \u001b[0m\u001b[92;40m+    name: str\u001b[0m\u001b[40m                                                                                              \u001b[0m\u001b[40m \u001b[0m\r\n\u001b[40m \u001b[0m\u001b[97;40m \u001b[0m\u001b[97;40m    description: str = \"\"\u001b[0m\u001b[40m                                                                                  \u001b[0m\u001b[40m \u001b[0m\r\n\u001b[40m \u001b[0m\u001b[97;40m \u001b[0m\u001b[97;40m    status: str = \"todo\"\u001b[0m\u001b[40m                                                                                   \u001b[0m\u001b[40m \u001b[0m\r\n\u001b[40m \u001b[0m\u001b[97;40m \u001b[0m\u001b[97;40m    owner_id: int | None = None\u001b[0m\u001b[40m                                                                            \u001b[0m\u001b[40m \u001b[0m\r\n\u001b[40m \u001b[0m\u001b[37;40m@@ -41,8 +41,8 @@\u001b[0m\u001b[40m                                                                                           \u001b[0m\u001b[40m \u001b[0m\r\n\u001b[40m \u001b[0m\u001b[97;40m \u001b[0m\u001b[97;40m        self._task_ids = count(1)\u001b[0m\u001b[40m                                                                          \u001b[0m\u001b[40m \u001b[0m\r\n\u001b[40m \u001b[0m\u001b[97;40m \u001b[0m\u001b[97;40m        self._user_ids = count(1)\u001b[0m\u001b[40m                                                                          \u001b[0m\u001b[40m \u001b[0m\r\n\u001b[40m \u001b[0m\u001b[97;40m \u001b[0m\u001b[40m                                                                                                           \u001b[0m\u001b[40m \u001b[0m\r\n\u001b[40m \u001b[0m\u001b[91;40m-    def add_task(self, title: str, description: str = \"\", owner_id: int | None = None) -> Task:\u001b[0m\u001b[40m            \u001b[0m\u001b[40m \u001b[0m\r\n\u001b[40m \u001b[0m\u001b[91;40m-        task = Task(id=next(self._task_ids), title=title,\u001b[0m\u001b[40m                                                  \u001b[0m\u001b[40m \u001b[0m\r\n\u001b[40m \u001b[0m\u001b[92;40m+    def add_task(self, name: str, description: str = \"\", owner_id: int | None = None) -> Task:\u001b[0m\u001b[40m             \u001b[0m\u001b[40m \u001b[0m\r\n\u001b[40m \u001b[0m\u001b[92;40m+        task = Task(id=next(self._task_ids), name=name,\u001b[0m\u001b[40m                                                    \u001b[0m\u001b[40m \u001b[0m\r\