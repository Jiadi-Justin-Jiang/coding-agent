[5.858685, "o", "✅ Return a 404 JSON error from GET /tasks/ when the task doesn't exist instead of raising KeyError (500), and\r\nadd a regression test.                                                                                        \r\n\r\n\u001b[40m                                                                                                              \u001b[0m\r\n\u001b[40m \u001b[0m\u001b[91;40m--- a/routes/tasks.py\u001b[0m\u001b[40m                                                                                       \u001b[0m\u001b[40m \u001b[0m\r\n\u001b[40m \u001b[0m\u001b[92;40m+++ b/routes/tasks.py\u001b[0m\u001b[40m                                                                                       \u001b[0m\u001b[40m \u001b[0m\r\n\u001b[40m \u001b[0m\u001b[37;40m@@ -37,7 +37,10 @@\u001b[0m\u001b[40m                                                                                          \u001b[0m\u001b[40m \u001b[0m\r\n\u001b[40m \u001b[0m\u001b[97;40m \u001b[0m\u001b[40m                                                                                                           \u001b[0m\u001b[40m \u001b[0m\r\n\u001b[40m \u001b[0m\u001b[97;40m \u001b[0m\u001b[97;40m@tasks_bp.get(\"/<int:task_id>\")\u001b[0m\u001b[40m                                                                            \u001b[0m\u001b[40m \u001b[0m\r\n\u001b[40m \u001b[0m\u001b[97;40m \u001b[0m\u001b[97;40mdef get_task(task_id: int):\u001b[0m\u001b[40m                                                                                \u001b[0m\u001b[40m \u001b[0m\r\n\u001b[40m \u001b[0m\u001b[91;40m-    task = _store().tasks[task_id]\u001b[0m\u001b[40m                                                                         \u001b[0m\u001b[40m \u001b[0m\r\n\u001b[40m \u001b[0m\u001b[92;40m+    \"\"\"Return one task as JSON, or a 404 error if it does not exist.\"\"\"\u001b[0m\u001b[40m                                    \u001b[0m\u001b[40m \u001b[0m\r\n\u001b[40m \u001b[0m\u001b[92;40m+    task = _store().tasks.get(task_id)\u001b[0m\u001b[40m                                                                     \u001b[0m\u001b[40m \u001b[0m\r\n\u001b[40m \u001b[0m\u001b[92;40m+    if task is None:\u001b[0m\u001b[40m                                                                                       \u001b[0m\u001b[40m \u001b[0m\r\n\u001b[40m \u001b[0m\u001b[92;40m+        return jsonify({\"error\": f\"Task {task_id} does not exist\"}), 404\u001b[0m\u001b[40m                                   \u001b[0m\u001b[40m \u001b[0m\r\n\u001b[40m \u001b[0m\u001b[97;40m \u001b[0m\u001b[97;40m    return jsonify(task.to_dict())\u001b[0m\u001b[40m                                                                         \u001b[0m\u001b[40m \u001b[0m\r\n\u001b[40m \u001b[0m\u001b[97;40m \u001b[0m\u001b[40m                                                                                                           \u001b[0m\u001b[40m \u001b[0m\r\n\u001b[40m \u001b[0m\u001b[97;40m \u001b[0m\u001b[40m                                                                                                           \u001b[0m\u001b[40m \u001b[0m\r\n\u001b[40m \u001b[0m\u001b[40m                                                                                                            \u001b[0m\u001b[40m \u001b[0m\r\n\u001b[40m \u001b[0m\u001b[91;40m--- a/tests/test_tasks.py\u001b[0m\u001b[40m                                                                                   \u001b[0m\u001b[40m \u001b[0m\r\n\u001b[40m \u001b[0m\u001b[92;40m+++ b/tests/test_tasks.py\u001b[0m\u001b[40m                                                                                   \u001b[0m\u001b[40m \u001b[0m\r\n\u001b[40m \u001b[0m\u001b[37;40m@@ -29,3 +29,9 @@\u001b[0m\u001b[40m                                                                                           \u001b[0m\u001b[40m \u001b[0m\r\n\u001b[40m \u001b[0m\u001b[97;40m \u001b[0m\u001b[97;40m    task_id = client.post(\"/tasks\", json={\"title\": \"t\"}).get_json()[\"id\"]\u001b[0m\u001b[40m                                  \u001b[0m\u001b[40m \u001b[0m\r\n\u001b[40m \u001b[0m\u001b[97;40m \u001b[0m\u001b[97;40m    resp = client.patch(f\"/tasks/{task_id}\", json={\"status\": \"bogus\"})\u001b[0m\u001b[40m                                     \u001b[0m\u001b[40m \u001b[0m\r\n\u001b[40m \u001b[0m\u001b[97;40m \u001b[0m\u001b[97;40m    assert resp.status_code == 400\u001b[0m\u001b[40m                                                                         \u001b[0m\u001b[40m \u001b[0m\r\n\u001b[40m \u001b[0m\u001b[92;40m+\u001b[0m\u001b[40m                                                                                                           \u001b[0m\u001b[40m \u001b[0m\r\n\u001b[40m \u001b[0m\u001b[92;40m+\u001b[0m\u001b[40m                                                                                                           \u001b[0m\u001b[40m \u001b[0m\r\n\u001b[40m \u001b[0m\u001b[92;40m+def test_get_missing_task_returns_404(client):\u001b[0m\u001b[40m                                                             \u001b[0m\u001b[40m \u001b[0m\r\n\u001b[40m \u001b[0m\u001b[92;40m+    \"\"\"Unknown task ids yield 404, not an un"]
[5.858708, "o", "handled KeyError.\"\"\"\u001b[0m\u001b[40m                                           \u001b[0m\u001b[40m \u001b[0m\r\n\u001b[40m \u001b[0m\u001b[92;40m+    resp = client.get(\"/tasks/999\")\u001b[0m\u001b[40m                                                                        \u001b[0m\u001b[40m \u001b[0m\r\n\u001b[40m \u001b[0m\u001b[92;40m+    assert resp.status_code == 404\u001b[0m\u001b[40m                                                                         \u001b[0m\u001b[40m \u001b[0m\r\n\u001b[40m                                                                                                              \u001b[0m\r\n\r\n\u001b[1mVerified:\u001b[0m lint clean · tests: 6 passed, 0 failed                                                              \r\n\r\n\u001b[1m • \u001b[0mruff auto-fixed lint issues in routes/tasks.py                                                             \r\n\u001b[1m • \u001b[0mself-correction 1: Add the docstrings required by the user's preference to the two functions I edited.     \r\n\u001b[1m • \u001b[0msay \u001b[1mundo\u001b[0m to revert (transaction \u001b[1;36;40mb518f2\u001b[0m)                                                                    \r\n"]
